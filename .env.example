# Copy to .env and adjust. Only this example file is committed; .env is gitignored.

# --- Postgres (consumed by the db service) ---
POSTGRES_USER=uke
POSTGRES_PASSWORD=uke_dev_password
POSTGRES_DB=uke
POSTGRES_PORT=5432

# --- Backend ---
# Hostname "db" is the compose service name. For host-side tooling outside
# Docker use localhost instead (see `make migrate-local` / `make test-local`).
DATABASE_URL=postgresql+asyncpg://uke:uke_dev_password@db:5432/uke
ENVIRONMENT=development
LOG_LEVEL=INFO
STORAGE_DIR=/data/storage
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Claude (server-side only; unused until milestone M4) ---
# Never expose this to the frontend. The web service does not receive it.
ANTHROPIC_API_KEY=

# --- Frontend ---
# Server components run inside the container network; the browser does not.
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
